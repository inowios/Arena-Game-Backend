# copy to .env and fill in (docker compose reads it); keep it out of git
JWT_SECRET=change-me-long-random
DATABASE_PASSWORD=arena

# HTTPS (docker compose --profile tls): the API host name; publish the app only on localhost behind Caddy
DOMAIN=api.example.com
APP_BIND=127.0.0.1
PUBLIC_BASE_URL=https://api.example.com

# shown on /privacy, /terms, /delete-account (store listings link these pages)
SUPPORT_EMAIL=
LEGAL_COMPANY=Inowios

# sign-in
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=com.inowios.arenacity

# app links (Play Console → App integrity → SHA-256; Apple developer team id) and store pages
ANDROID_CERT_SHA256=
IOS_TEAM_ID=
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.inowios.arenacity
APP_STORE_URL=

# purchases: Play service-account JSON and App Store Connect in-app purchase key (.p8 contents); dev receipts off
IAP_DEV_MODE=false
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
# optional, e.g. /app/secrets/AppleRootCA-G3.cer (./secrets is mounted read-only)
APPSTORE_ROOT_CERT_PATH=

# push (Firebase service account JSON contents)
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# ops: token for /admin/* and /metrics, at least 16 characters (openssl rand -hex 24); empty = disabled
ADMIN_TOKEN=

CORS_ALLOWED_HOSTS=
KTOR_DEVELOPMENT=false
CLIENT_MIN_VERSION=0.1.0
PORT=8080
