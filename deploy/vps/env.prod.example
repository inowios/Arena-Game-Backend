# /opt/arenacity/prod/.env.prod — never in git. setup.sh fills the secrets with random values on the first run.
# Saved off-server by /opt/ops/backup.sh (every /opt/**/.env.prod) — keep a copy in the password manager too.

# --- database (the same user/password for the container and the app) ---
POSTGRES_DB=matchdayclub
POSTGRES_USER=matchday
POSTGRES_PASSWORD=__RANDOM__
DATABASE_USER=matchday
DATABASE_PASSWORD=__SAME_AS_POSTGRES_PASSWORD__

# --- auth ---
JWT_SECRET=__RANDOM__
JWT_ISSUER=https://arenacity.arenaproplay.com
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=com.inowios.matchdayclub

# --- public pages, invite links, app links ---
PUBLIC_BASE_URL=https://arenacity.arenaproplay.com
SUPPORT_EMAIL=
LEGAL_COMPANY=Inowios
IOS_TEAM_ID=
ANDROID_CERT_SHA256=
APP_STORE_URL=
PLAY_STORE_URL=

# --- ops: /admin/* and /metrics (X-Admin-Token) ---
ADMIN_TOKEN=__RANDOM__

# --- purchases (empty until the store accounts are set up) ---
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_TOKEN=
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_ROOT_CERT_PATH=

# --- push ---
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

CLIENT_MIN_VERSION=0.1.0
MATCHDAY_SCHEDULER_ENABLED=true
